    {
      "id": 1,
      "title": "DB File Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "sqlite" },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "sqlite" },
          "rawQueryText": "SELECT page_count * page_size AS size FROM pragma_page_count(), pragma_page_size()",
          "refId": "A",
          "queryText": "SELECT page_count * page_size AS size FROM pragma_page_count(), pragma_page_size()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 104857600 },
              { "color": "red", "value": 524288000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "OHLCV Rows by Symbol + Timeframe",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "sqlite" },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "sqlite" },
          "rawQueryText": "SELECT symbol || ' ' || timeframe AS metric, COUNT(*) AS value FROM ohlcv GROUP BY symbol, timeframe ORDER BY value DESC",
          "refId": "A",
          "queryText": "SELECT symbol || ' ' || timeframe AS metric, COUNT(*) AS value FROM ohlcv GROUP BY symbol, timeframe ORDER BY value DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true
      }
    },
    {
      "id": 3,
      "title": "OHLCV Last Timestamp by Symbol",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
