      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "sqlite" },
          "rawQueryText": "SELECT symbol, timeframe, MAX(timestamp) AS last_ts FROM ohlcv GROUP BY symbol, timeframe ORDER BY symbol, timeframe",
          "refId": "A",
          "queryText": "SELECT symbol, timeframe, MAX(timestamp) AS last_ts FROM ohlcv GROUP BY symbol, timeframe ORDER BY symbol, timeframe"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "last_ts" },
